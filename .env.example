# Public build-time setting: leave empty until a private production origin exists.
NEXT_PUBLIC_PRIVATE_APP_ORIGIN=
# Private server only. Configure through Replit Secrets/environment settings.
DATABASE_URL=
AUTH_ENVIRONMENT=
PRIVATE_APP_ORIGIN=
PREVIEW_AUTH_ORIGIN=
# /private for workspace preview; empty for a dedicated private production host.
BASE_PATH=
# Vault remains disabled until the final security/operations stage.
VAULTWARDEN_ORIGIN=
