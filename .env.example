# Public build-time setting: leave empty until a private production origin exists.
NEXT_PUBLIC_PRIVATE_APP_ORIGIN=
# Private server only. Configure through the hosting provider's secret/environment settings (e.g. Vercel).
DATABASE_URL=
AUTH_ENVIRONMENT=
PRIVATE_APP_ORIGIN=
PREVIEW_AUTH_ORIGIN=
# /private for workspace preview; empty for a dedicated private production host.
BASE_PATH=
# Optional: https origin of the separate Vaultwarden. Enables the "Tresor öffnen" button (link only).
VAULTWARDEN_ORIGIN=

# Public, non-secret: HTTPS URL of the live-translation proxy (workers/translate). Unset = live option hidden.
# NEXT_PUBLIC_TRANSLATE_ENDPOINT=https://jonas-translate.example.workers.dev/
